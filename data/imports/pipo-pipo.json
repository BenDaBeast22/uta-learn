      "end": 23.05,
      "text": "(ぴぽ)"
    },
    {
      "id": "l2",
      "start": 23.05,
      "end": 25.62,
      "text": "僕は答えるぴぽぴぽ"
    },
    {
      "id": "l3",
      "start": 25.62,
      "end": 28.32,
      "text": "悲しい時もぴぽぴぽ"
    },
    {
      "id": "l4",
      "start": 28.32,
      "end": 31.04,
      "text": "笑う時も、不機嫌でも"
    },
    {
      "id": "l5",
      "start": 31.04,
      "end": 33.78,
      "text": "ぴぽぴぽ、エレクトリックサウンド"
    },
    {
      "id": "l6",
      "start": 33.78,
      "end": 36.74,
      "text": "僕は答えるぴぽぴぽ"
    },
    {
      "id": "l7",
      "start": 36.74,
      "end": 39.38,
      "text": "どんな返事もぴぽぴぽ"
    },
    {
      "id": "l8",
      "start": 39.38,
      "end": 42.24,
      "text": "僕の気持ちは君と同じ"
    },
    {
      "id": "l9",
      "start": 42.24,
      "end": 45.34,
      "text": "数えきれないよ"
    },
    {
      "id": "l10",
      "start": 45.34,
      "end": 50.99,
      "text": "ママにオムレツ作ってあげたの (僕はぴぽぴぽ)"
    },
    {
      "id": "l11",
      "start": 50.99,
      "end": 56.59,
      "text": "この司会者のネクタイの模様変ね (僕はぴぽぴぽ)"
    },
    {
      "id": "l12",
      "start": 56.59,
      "end": 61.55,
      "text": "バラの花ってオキシドールの匂いに似てる"
    },
    {
      "id": "l13",
      "start": 61.55,
      "end": 67.34,
      "text": "聞いてわたしのかわいいお友達"
    },
    {
      "id": "l14",
      "start": 67.34,
      "end": 69.41,
      "text": "ぴぽ、ぴぽ"
    },
    {
      "id": "l15",
      "start": 69.41,
      "end": 72.33,
      "text": "ぴぽっぴぽぴっ"
    },
    {
      "id": "l16",
      "start": 72.33,
      "end": 78.16,
      "text": "だい、すき、君のこと"
    },
    {
      "id": "l17",
      "start": 78.16,
      "end": 80.65,
      "text": "ぴぽ、ぴぽ"
    },
    {
      "id": "l18",
      "start": 80.65,
      "end": 83.35,
      "text": "ぴぽっぴぽぴっ"
    },
    {
      "id": "l19",
      "start": 83.35,
      "end": 94.5,
      "text": "あい、して、僕のこと"
    },
    {
      "id": "l20",
      "start": 94.5,
      "end": 100.06,
      "text": "ぴぽ (ぴぽ) ぴぽ (ぴぽ)"
