{
  "id": "iris-out",
  "title": "IRIS OUT",
  "artist": "Kenshi Yonezu",
  "lines": [
    {
      "id": "l1",
      "start": 18,
      "end": 19.75,
      "text": "駄目駄目駄目"
    },
    {
      "id": "l2",
      "start": 19.75,
      "end": 25,
      "text": "脳みその中から「やめろ馬鹿」と喚くモラリティ"
    },
    {
      "id": "l3",
      "start": 25,
      "end": 26.75,
      "text": "ダーリンベイビーダーリン"
    },
    {
      "id": "l4",
      "start": 26.75,
      "end": 28,
      "text": "半端なくラブ！"
    },
    {
      "id": "l5",
      "start": 28,
      "end": 32,
      "text": "ときらめき浮き足立つフィロソフィ"
    },
    {
      "id": "l6",
      "start": 32,
      "end": 33.5,
      "text": "死ぬほど可愛い上目遣い"
    },
    {
      "id": "l7",
      "start": 33.5,
      "end": 35.75,
      "text": "なにがし法に触れるくらい"
    },
    {
      "id": "l8",
      "start": 35.75,
      "end": 36.25,
      "text": "ばら撒く乱心"
    },
    {
      "id": "l9",
      "start": 36.25,
      "end": 37,
      "text": "気づけば蕩尽"
    },
    {
      "id": "l10",
      "start": 37,
      "end": 38.9,
      "text": "この世に生まれた君が悪い"
    },
    {
      "id": "l11",
      "start": 38.9,
      "end": 40.25,
      "text": "やたらとしんどい恋煩い"
    },
    {
      "id": "l12",
      "start": 40.25,
      "end": 42.9,
      "text": "バラバラんなる頭とこの身体"
    },
    {
      "id": "l13",
      "start": 42.9,
      "end": 44.85,
      "text": "頸動脈からアイラブユーが噴き出て"
    },
    {
      "id": "l14",
      "start": 44.85,
      "end": 46,
      "text": "IRIS OUT"
    },
    {
      "id": "l15",
      "start": 46,
      "end": 48,
      "text": "一体どうしようこの想いを"
    },
    {
      "id": "l16",
      "start": 48,
      "end": 50,
      "text": "どうしようあばらの奥を"
    },
    {
      "id": "l17",
      "start": 50,
      "end": 53.85,
      "text": "ザラメが溶けてゲロになりそう(ぼんっ)"
    },
    {
      "id": "l18",
      "start": 53.85,
      "end": 57,
      "text": "瞳孔バチ開いて溺れ死にそう"
    },
    {
      "id": "l19",
      "start": 57,
      "end": 61,
      "text": "今この世で君だけ大正解"
    },
    {
      "id": "l20",
      "start": 61,
      "end": 64.34,
      "text": "ダーリンダーリンダーリンダーリン"
    },
    {
      "id": "l21",
      "start": 64.34,
      "end": 74.75,
      "text": "ダーリンダーリンダーリンダーリン"
    },
    {
      "id": "l22",
      "start": 74.75,
      "end": 76.25,
      "text": "ひっくり返っても勝ちようない"
    },
    {
      "id": "l23",
      "start": 76.25,
      "end": 78,
      "text": "君だけルールは適用外"
    },
    {
      "id": "l24",
      "start": 78,
      "end": 80,
      "text": "四つともオセロは黒しかない"
    },
    {
      "id": "l25",
      "start": 80,
      "end": 81.9,
      "text": "カツアゲ放題"
    },
    {
      "id": "l26",
      "start": 81.9,
      "end": 84,
      "text": "君が笑顔で放ったアバダケダブラ"
    },
    {
      "id": "l27",
      "start": 84,
      "end": 85.9,
      "text": "デコにスティグマ申し訳ねぇな"
    },
    {
      "id": "l28",
      "start": 85.9,
      "end": 86.9,
      "text": "矢を刺して"
    },
    {
      "id": "l29",
      "start": 86.9,
      "end": 89,
      "text": "貫いて"
    },
    {
      "id": "l30",
      "start": 89,
      "end": 89.85,
      "text": "ここ弱点？"
    },
    {
      "id": "l31",
      "start": 89.85,
      "end": 90.85,
      "text": "死ぬほど可愛い上目遣い"
    },
    {
      "id": "l32",
      "start": 90.85,
      "end": 92.1,
      "text": "なにがし法に触れるくらい"
    },
    {
      "id": "l33",
      "start": 92.1,
      "end": 93,
      "text": "ばら撒く乱心"
    },
    {
      "id": "l34",
      "start": 93,
      "end": 94,
      "text": "気づけば蕩尽"
    },
    {
      "id": "l35",
      "start": 94,
      "end": 95.85,
      "text": "この世に生まれた君が悪い"
    },
    {
      "id": "l36",
      "start": 95.85,
      "end": 97.75,
      "text": "パチモンでもいい何でもいい"
    },
    {
      "id": "l37",
      "start": 97.75,
      "end": 99.25,
      "text": "今君と名付いてる全て欲しい"
    },
    {
      "id": "l38",
      "start": 99.25,
      "end": 102,
      "text": "頸動脈からアイラブユーが噴き出て"
    },
