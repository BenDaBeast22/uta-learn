{
  "id": "ma-meilleure-ennemie",
  "title": "Ma Meilleure Ennemie",
  "artist": "Stromae",
  "lines": [
    {
      "id": "l1",
      "start": 0.1,
      "end": 2.92,
      "text": "Je t'aime, je te hais, je t'aime, je te hais"
    },
    {
      "id": "l2",
      "start": 2.92,
      "end": 5.69,
      "text": "Je t'aime, je te hais, je t'aime, je te hais"
    },
    {
      "id": "l3",
      "start": 5.69,
      "end": 8.37,
      "text": "Je t'aime, je te hais, je t'aime, je te hais"
    },
    {
      "id": "l4",
      "start": 8.37,
      "end": 10.72,
      "text": "Je t'aime, je te hais, je t'aime, je te hais"
    },
    {
      "id": "l5",
      "start": 10.72,
      "end": 13.53,
      "text": "T'es la meilleure chose qui m'est arrivée"
    },
    {
      "id": "l6",
      "start": 13.53,
      "end": 15.95,
      "text": "Mais aussi la pire chose qui m'est arrivée"
    },
    {
      "id": "l7",
      "start": 15.95,
      "end": 19.1,
      "text": "Ce jour où je t'ai rencontrée, j'aurais peut-être préféré"
    },
    {
      "id": "l8",
      "start": 19.1,
      "end": 22.21,
      "text": "Que ce jour ne soit jamais arrivé (arrivé)"
    },
    {
      "id": "l9",
      "start": 22.21,
      "end": 24.14,
      "text": "La pire des bénédictions"
    },
    {
      "id": "l10",
      "start": 24.14,
      "end": 26.1,
      "text": "La plus belle des malédictions"
    },
    {
      "id": "l11",
      "start": 26.1,
      "end": 27.64,
      "text": "De toi j'devrais m'éloigner"
    },
    {
      "id": "l12",
      "start": 27.64,
      "end": 29.62,
      "text": "Mais comme dit le dicton"
    },
    {
      "id": "l13",
      "start": 29.62,
      "end": 32.48,
      "text": "\"Plutôt qu'être seul, mieux vaut être mal accompagné\""
    },
    {
      "id": "l14",
      "start": 32.48,
      "end": 36.11,
      "text": "Tu sais c'qu'on dit"
    },
    {
      "id": "l15",
      "start": 36.11,
      "end": 38.03,
      "text": "\"Sois près d'tes amis les plus chers\""
    },
    {
      "id": "l16",
      "start": 38.03,
      "end": 41.02,
      "text": "Mais aussi"
    },
    {
      "id": "l17",
      "start": 41.02,
      "end": 43.13,
      "text": "\"Encore plus près d'tes adversaires\""
    },
    {
      "id": "l18",
      "start": 43.13,
      "end": 46.21,
      "text": "Mais ma meilleure ennemie, c'est toi"
    },
    {
      "id": "l19",
      "start": 46.21,
      "end": 54.04,
      "text": "Fuis-moi, le pire c'est toi et moi"
    },
    {
      "id": "l20",
      "start": 54.04,
      "end": 57.18,
      "text": "Mais si tu cherches encore ma voix"
    },
    {
      "id": "l21",
      "start": 57.18,
      "end": 66,
      "text": "Oublie-moi, le pire c'est toi et moi"
    },
    {
      "id": "l22",
      "start": 66,
      "end": 70.68,
      "text": "Pourquoi ton prénom me blesse"
    },
    {
      "id": "l23",
      "start": 70.68,
      "end": 76.98,
      "text": "Quand il se cache juste là dans l'espace?"
    },
    {
      "id": "l24",
      "start": 76.98,
      "end": 78.95,
      "text": "C'est quelle émotion?"
    },
    {
      "id": "l25",
      "start": 78.95,
      "end": 83.74,
      "text": "D'la haine ou la douceur"
    },
    {
      "id": "l26",
      "start": 83.74,
      "end": 87.69,
      "text": "Quand j'entends ton prénom?"
    },
    {
      "id": "l27",
      "start": 87.69,
      "end": 92.54,
      "text": "Je t'avais dit \"ne regarde pas en arrière\""
    },
    {
      "id": "l28",
      "start": 92.54,
      "end": 97.71,
      "text": "Le passé qui te suit, te fait la guerre"
    },
    {
      "id": "l29",
      "start": 97.71,
      "end": 100.69,
      "text": "Mais ma meilleure ennemie, c'est toi"
    },
    {
      "id": "l30",
      "start": 100.69,
      "end": 108.55,
      "text": "Fuis-moi, le pire c'est toi et moi"
    },
    {
      "id": "l31",
      "start": 108.55,
      "end": 111.62,
      "text": "Mais ma meilleure ennemie, c'est toi"
    },
    {
      "id": "l32",
