{
  "id": "idol",
  "title": "Idol",
  "artist": "Yaosobi",
  "lines": [
    {
      "id": "l1",
      "start": 2.67,
      "end": 4.77,
      "text": "無敵の笑顔で荒らすメディア"
    },
    {
      "id": "l2",
      "start": 4.77,
      "end": 7.37,
      "text": "知りたいその秘密ミステリアス"
    },
    {
      "id": "l3",
      "start": 7.37,
      "end": 10.72,
      "text": "抜けてるとこさえ彼女のエリア"
    },
    {
      "id": "l4",
      "start": 10.72,
      "end": 13.35,
      "text": "完璧で嘘つきな君は"
    },
    {
      "id": "l5",
      "start": 13.35,
      "end": 16.13,
      "text": "天才的なアイドル様"
    },
    {
      "id": "l6",
      "start": 16.13,
      "end": 18.98,
      "text": "(You're my savior, you're my saving grace)"
    },
    {
      "id": "l7",
      "start": 18.98,
      "end": 20.52,
      "text": "今日何食べた？"
    },
    {
      "id": "l8",
      "start": 20.52,
      "end": 22.16,
      "text": "好きな本は？"
    },
    {
      "id": "l9",
      "start": 22.16,
      "end": 24.68,
      "text": "遊びに行くならどこに行くの？"
    },
    {
      "id": "l10",
      "start": 24.68,
      "end": 26.33,
      "text": "何も食べてない"
    },
    {
      "id": "l11",
      "start": 26.33,
      "end": 27.49,
      "text": "それは内緒"
    },
    {
      "id": "l12",
      "start": 27.49,
      "end": 29.55,
      "text": "何を聞かれても"
    },
    {
      "id": "l13",
      "start": 29.55,
      "end": 30.66,
      "text": "のらりくらり"
    },
    {
      "id": "l14",
      "start": 30.66,
      "end": 31.81,
      "text": "そう淡々と"
    },
    {
      "id": "l15",
      "start": 31.81,
      "end": 32.98,
      "text": "だけど燦々と"
    },
    {
      "id": "l16",
      "start": 32.98,
      "end": 36.27,
      "text": "見えそうで見えない秘密は蜜の味"
    },
    {
      "id": "l17",
      "start": 36.27,
      "end": 37.69,
      "text": "あれもないないない"
    },
    {
      "id": "l18",
      "start": 37.69,
      "end": 38.71,
      "text": "これもないないない"
    },
    {
      "id": "l19",
      "start": 38.71,
      "end": 39.8,
      "text": "好きなタイプは？"
    },
    {
      "id": "l20",
      "start": 39.8,
      "end": 40.92,
      "text": "相手は？"
    },
    {
      "id": "l21",
      "start": 40.92,
      "end": 41.99,
      "text": "さあ答えて"
    },
    {
      "id": "l22",
      "start": 41.99,
      "end": 47.66,
      "text": "「誰かを好きになることなんて私分からなくてさ」"
    },
    {
      "id": "l23",
      "start": 47.66,
      "end": 50.62,
      "text": "嘘か本当か知り得ない"
    },
    {
      "id": "l24",
      "start": 50.62,
      "end": 54.23,
      "text": "そんな言葉にまた一人堕ちる"
    },
    {
      "id": "l25",
      "start": 54.23,
      "end": 56.25,
      "text": "また好きにさせる"
    },
    {
      "id": "l26",
      "start": 56.25,
      "end": 59.2,
      "text": "誰もが目を奪われていく"
    },
    {
      "id": "l27",
      "start": 59.2,
      "end": 62.51,
      "text": "君は完璧で究極のアイドル"
    },
    {
      "id": "l28",
      "start": 62.51,
      "end": 64.95,
      "text": "金輪際現れない"
    },
    {
      "id": "l29",
      "start": 64.95,
      "end": 68.01,
      "text": "一番星の生まれ変わり"
    },
    {
      "id": "l30",
      "start": 68.01,
      "end": 71.45,
      "text": "ああ その笑顔で愛してるで"
    },
    {
      "id": "l31",
      "start": 71.45,
      "end": 74.43,
      "text": "誰も彼も虜にしていく"
    },
    {
      "id": "l32",
      "start": 74.43,
      "end": 76.97,
      "text": "その瞳がその言葉が"
    },
    {
      "id": "l33",
      "start": 76.97,
      "end": 80.31,
      "text": "嘘でもそれは完全なアイ"
    },
    {
      "id": "l34",
      "start": 80.31,
      "end": 83.03,
      "text": "はいはいあの子は特別です"
    },
    {
      "id": "l35",
      "start": 83.03,
      "end": 85.53,
      "text": "我々はハナからおまけです"
    },
    {
      "id": "l36",
      "start": 85.53,
      "end": 88.74,
      "text": "お星様の引き立て役Bです"
    },
    {
      "id": "l37",
      "start": 88.74,
      "end": 91.21,
      "text": "全てがあの子のお陰なわけない"
    },
    {
      "id": "l38",
      "start": 91.21,
      "end": 92.34,
      "text": "洒落臭い"
    },
    {
      "id": "l39",
      "start": 92.34,
      "end": 94.48,
      "text": "妬み嫉妬なんてないわけがない"
    },
    {
      "id": "l40",
      "start": 94.48,
      "end": 95.8,
      "text": "これはネタじゃない"
    },
    {
      "id": "l41",
      "start": 95.8,
      "end": 96.68,
      "text": "からこそ許せない"
    },
    {
      "id": "l42",
      "start": 96.68,
      "end": 98.98,
      "text": "完璧じゃない君じゃ許せない"
    },
    {
      "id": "l43",
      "start": 98.98,
      "end": 100.05,
      "text": "自分を許せない"
    },
    {
      "id": "l44",
      "start": 100.05,
      "end": 102.54,
      "text": "誰よりも強い君以外は認めない"
    },
    {
      "id": "l45",
      "start": 102.54,
      "end": 105.39,
      "text": "誰もが信じ崇めてる"
    },
    {
      "id": "l46",
      "start": 105.39,
      "end": 108.54,
      "text": "まさに最強で無敵のアイドル"
    },
    {
      "id": "l47",
      "start": 108.54,
      "end": 111.31,
      "text": "弱点なんて見当たらない"
    },
    {
      "id": "l48",
      "start": 111.31,
      "end": 114.3,
      "text": "一番星を宿している"
    },
    {
      "id": "l49",
      "start": 114.3,
      "end": 117.26,
      "text": "弱いとこなんて見せちゃダメダメ"
    },
    {
      "id": "l50",
      "start": 117.26,
      "end": 120.33,
      "text": "知りたくないとこは見せずに"
    },
    {
      "id": "l51",
      "start": 120.33,
      "end": 123.12,
      "text": "唯一無二じゃなくちゃイヤイヤ"
    },
    {
      "id": "l52",
      "start": 123.12,
      "end": 126.65,
      "text": "それこそ本物のアイ"
    },
    {
      "id": "l53",
      "start": 126.65,
      "end": 129.39,
      "text": "得意の笑顔で沸かすメディア"
    },
    {
      "id": "l54",
      "start": 129.39,
      "end": 132.55,
      "text": "隠しきるこの秘密だけは"
    },
    {
      "id": "l55",
      "start": 132.55,
      "end": 136.19,
      "text": "愛してるって嘘で積むキャリア"
    },
    {
      "id": "l56",
      "start": 136.19,
      "end": 138.94,
      "text": "これこそ私なりの愛だ"
    },
    {
      "id": "l57",
      "start": 138.94,
      "end": 142.15,
      "text": "流れる汗も綺麗なアクア"
    },
    {
      "id": "l58",
      "start": 142.15,
      "end": 145.3,
      "text": "ルビーを隠したこの瞼"
    },
    {
      "id": "l59",
      "start": 145.3,
      "end": 148.59,
      "text": "歌い踊り舞う私はマリア"
    },
    {
      "id": "l60",
      "start": 148.59,
      "end": 152.95,
      "text": "そう嘘はとびきりの愛だ"
    },
    {
      "id": "l61",
      "start": 152.95,
      "end": 155.85,
      "text": "誰かに愛されたことも"
    },
    {
      "id": "l62",
      "start": 155.85,
      "end": 159.51,
      "text": "誰かのこと愛したこともない"
    },
    {
      "id": "l63",
      "start": 159.51,
      "end": 165.33,
      "text": "そんな私の嘘がいつか本当になること"
    },
    {
      "id": "l64",
      "start": 165.33,
      "end": 166.46,
      "text": "（信じてる）"
    },
    {
      "id": "l65",
      "start": 166.46,
      "end": 169.45,
      "text": "いつかきっと全部手に入れる"
    },
    {
      "id": "l66",
      "start": 169.45,
      "end": 172.76,
      "text": "私はそう欲張りなアイドル"
    },
    {
      "id": "l67",
      "start": 172.76,
      "end": 175.1,
      "text": "等身大でみんなのこと"
    },
    {
      "id": "l68",
      "start": 175.1,
      "end": 178.27,
      "text": "ちゃんと愛したいから"
    },
    {
      "id": "l69",
      "start": 178.27,
      "end": 180.3,
      "text": "今日も嘘をつくの"
    },
    {
      "id": "l70",
      "start": 180.3,
      "end": 184.79,
      "text": "この言葉がいつか本当になる日を願って"
    },
    {
      "id": "l71",
      "start": 184.79,
      "end": 186.46,
      "text": "それでもまだ"
    },
    {
      "id": "l72",
      "start": 186.46,
      "end": 190.19,
      "text": "君と君にだけは言えずにいたけど"
    },
    {
      "id": "l73",
      "start": 190.19,
      "end": 191.98,
      "text": "ああ やっと言えた"
    },
    {
      "id": "l74",
      "start": 191.98,
      "end": 194.53,
      "text": "これは絶対嘘じゃない"
    },
    {
      "id": "l75",
      "start": 194.53,
      "end": 207.42,
      "text": "愛してる"
    },
    {
      "id": "l76",
      "start": 207.42,
      "end": 211.42,
      "text": "(You're my savior, my true savior, my saving grace)"
    }
  ]
}